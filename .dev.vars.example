# Local-only Cloudflare Pages / Wrangler variables.
# Copy this file to `.dev.vars` for local `npm run dev`.

MOCK_MODE=false
ALLOW_MOCK_PRICES=false
CACHE_TTL_MINUTES=60
TICKETMASTER_DAILY_CAP=1000
TICKETMASTER_STALE_TTL_HOURS=168
CLICK_TRACKING_ENABLED=true
TICKETMASTER_DISCOVERY_ENABLED=true
TICKETMASTER_EVENTS_TTL_MINUTES=30
TICKETMASTER_ARTIST_EVENTS_LIMIT=100
TICKETMASTER_DISCOVERY_PRICE_CHECKS_ENABLED=false
TICKETMASTER_DISCOVERY_COUNTRY=

TICKETMASTER_API_KEY=your_key_here
SEATGEEK_CLIENT_ID=your_client_id_here
SEATGEEK_CLIENT_SECRET=your_client_secret_here
VIVID_SEATS_API_KEY=your_key_here
TICKETNETWORK_PUBLIC_ENABLED=false
TICKETNETWORK_PRICE_DISPLAY_ENABLED=false
TICKETLIQUIDATOR_PUBLIC_ENABLED=false
TICKETLIQUIDATOR_PRICE_DISPLAY_ENABLED=false
STUBHUB_INTERNATIONAL_PUBLIC_ENABLED=false
STUBHUB_INTERNATIONAL_PRICE_DISPLAY_ENABLED=false
# The SeatGeek publisher AccountSID/AuthToken are the only approved Impact
# credentials for every active affiliate provider. Retired Ticketmaster
# IMPACT_ACCOUNT_SID / IMPACT_AUTH_TOKEN values are deliberately ignored.
IMPACT_SEATGEEK_ACCOUNT_SID=your_seatgeek_account_sid_here
IMPACT_SEATGEEK_AUTH_TOKEN=your_seatgeek_auth_token_here
# Provider routes use their own campaign/program id or pxf.io base URL.
# IMPACT_SEATGEEK_CAMPAIGN_ID=your_seatgeek_campaign_id_here
# IMPACT_SEATGEEK_BASE_TRACKING_URL=https://seatgeek.pxf.io/your_code_here
# IMPACT_VIVIDSEATS_ACCOUNT_SID=your_vividseats_account_sid_here
# IMPACT_VIVIDSEATS_AUTH_TOKEN=your_vividseats_auth_token_here
# IMPACT_VIVIDSEATS_CAMPAIGN_ID=your_vividseats_campaign_id_here
# IMPACT_VIVIDSEATS_BASE_TRACKING_URL=https://vividseats.pxf.io/your_code_here
# Impact Catalogs provider config. Catalog IDs are optional; when omitted the
# integration searches all available catalogs and isolates rows by campaign ID.
# Catalog requests default to the documented v15 API.
# IMPACT_CATALOG_API_VERSION=15
# Keep the public/display flags
# false until catalog access, program identity, tracking, and event matches are
# verified in the relevant Impact account.
# IMPACT_TICKETNETWORK_ACCOUNT_SID=your_ticketnetwork_account_sid_here
# IMPACT_TICKETNETWORK_AUTH_TOKEN=your_ticketnetwork_auth_token_here
# IMPACT_TICKETNETWORK_CAMPAIGN_ID=your_ticketnetwork_campaign_id_here
# IMPACT_TICKETNETWORK_CATALOG_ID=your_ticketnetwork_catalog_id_here
# IMPACT_TICKETNETWORK_BASE_TRACKING_URL=https://ticketnetwork.pxf.io/your_code_here
# IMPACT_TICKETLIQUIDATOR_ACCOUNT_SID=your_ticketliquidator_account_sid_here
# IMPACT_TICKETLIQUIDATOR_AUTH_TOKEN=your_ticketliquidator_auth_token_here
# IMPACT_TICKETLIQUIDATOR_CAMPAIGN_ID=your_ticketliquidator_campaign_id_here
# IMPACT_TICKETLIQUIDATOR_CATALOG_ID=your_ticketliquidator_catalog_id_here
# IMPACT_TICKETLIQUIDATOR_BASE_TRACKING_URL=https://ticketliquidator.pxf.io/your_code_here
# IMPACT_STUBHUB_INTERNATIONAL_ACCOUNT_SID=your_stubhub_international_account_sid_here
# IMPACT_STUBHUB_INTERNATIONAL_AUTH_TOKEN=your_stubhub_international_auth_token_here
# IMPACT_STUBHUB_INTERNATIONAL_CAMPAIGN_ID=your_stubhub_international_campaign_id_here
# IMPACT_STUBHUB_INTERNATIONAL_CATALOG_ID=your_stubhub_international_catalog_id_here
# IMPACT_STUBHUB_INTERNATIONAL_BASE_TRACKING_URL=https://stubhubinternational.pxf.io/your_code_here
PUBLIC_SITE_PHASE=pages_mvp_market_watch
ENABLE_PUBLIC_TICKET_LISTINGS=false

# D1 binding, configured in wrangler.toml / Cloudflare Pages dashboard rather than as text:
# DEMAND_DB=tourticketcompare-demand
