node_modules
.wrangler/
.dev.vars
.env
.DS_Store

# Generated audit evidence. Each audit writes these only on a full run; the
# `--check` mode that CI and test:mvp use exits before writing. Their
# generated_at stamp changes every run, so committing them is pure churn — they
# are evidence, regenerated on demand, not state. baseline.json alongside them is
# deliberately NOT ignored: it is the drift anchor `--check` reads.
reports/indexable-surface/indexable-surface.json
reports/indexable-surface/indexable-surface.md
reports/internal-links/internal-links-audit.json
reports/internal-links/internal-links-audit.md

# Generated SeatGeek proposal output (dry-run candidates; uploaded separately, not committed)
reports/seatgeek-url-candidates.json
reports/seatgeek-*.json

# Generated artist-import proposal output (dry-run candidates)
candidates/

# Audit artifacts (generated during CI runs, uploaded separately)
.audit/
artifacts/

# Ticketmaster new-shows discovery output (candidate batch, coverage heartbeat
# and withheld-review report). Regenerated on every recogniser run and uploaded
# as an Actions artifact by tm-new-shows-pr.yml — never committed.
.tm-discovery/

# Python bytecode caches (from scripts/ tooling and its --self-test runs)
__pycache__/
*.pyc

# Written by automation-health.yml so the work queue can read structured
# findings; regenerated every run, never committed.
automation-health-findings.json
generated-freshness-findings.json
