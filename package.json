{
  "name": "tour-ticket-compare",
  "version": "1.0.0",
  "type": "module",
  "description": "Independent Cloudflare Pages stadium tour market watch MVP.",
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-date=2025-01-01 --port 3000",
    "build": "npm run test:mvp",
    "deploy": "wrangler pages deploy public",
    "deploy:pages": "wrangler pages deploy public",
    "deploy:pages:safe": "npm run test:mvp && wrangler pages deploy public",
    "test:mvp": "npm run events:validate:self-test && npm run validate:artist-providers && node scripts/smoke-prelaunch.mjs",
    "validate:artist-providers": "node scripts/validate-artist-provider-claims.mjs",
    "test:prelaunch": "npm run test:mvp",
    "demand:migrate": "wrangler d1 execute tourticketcompare-demand --remote --file migrations/0001_demand.sql",
    "demand:export": "wrangler d1 execute tourticketcompare-demand --remote --command \"SELECT * FROM email_subscribers\"",
    "events:csv": "python3 scripts/csv-to-events.py",
    "events:partition": "python3 scripts/partition-events.py",
    "events:sync": "python3 scripts/sync-events-data.py",
    "events:validate": "python3 scripts/validate-events.py",
    "events:validate:prod": "python3 scripts/validate-events.py --for-production",
    "events:validate:self-test": "python3 scripts/validate-events.py --self-test",
    "events:validate:partitions": "node scripts/validate-partitions.mjs",
    "events:update": "python3 scripts/csv-to-events.py && python3 scripts/validate-events.py && python3 scripts/partition-events.py && python3 scripts/sync-events-data.py",
    "artist:check": "node scripts/validate-artist.mjs",
    "artists:propose": "node scripts/propose-artists.mjs",
    "artists:diagnose-ticketmaster": "node scripts/propose-artists.mjs --diagnose-ticketmaster",
    "artists:apply-preview": "node scripts/apply-artists.mjs",
    "guides:validate": "node scripts/validate-guide-routes.mjs",
    "providers:validate": "node scripts/validate-provider-structure.js",
    "validate:provider-allowlists": "node scripts/validate-provider-allowlists.mjs",
    "providers:enrich": "node scripts/enrich-events-with-provider-links.js",
    "test:providers": "npm run providers:validate",
    "data:stats": "node scripts/report-data-stats.mjs",
    "audit:links": "node scripts/verify-outbound-links.mjs",
    "audit:tm-events": "node scripts/audit-tm-events.mjs",
    "audit:report": "node scripts/daily-audit-report.mjs",
    "audit:bump-dates": "node scripts/bump-verified-dates.mjs",
    "test:bump-guard": "node scripts/test-bump-verified-dates-guard.mjs",
    "audit:candidates": "node scripts/audit-candidates.mjs",
    "candidates:score": "node scripts/score-candidates.mjs",
    "candidates:report": "node scripts/report-candidates.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.90.0"
  }
}
