{
  "name": "tour-ticket-compare",
  "version": "1.0.0",
  "type": "module",
  "description": "Independent Cloudflare Pages stadium tour market watch MVP.",
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-date=2025-01-01 --port 3000",
    "build": "npm run test:mvp",
    "deploy": "wrangler pages deploy public",
    "deploy:pages": "wrangler pages deploy public",
    "deploy:pages:safe": "npm run test:mvp && wrangler pages deploy public",
    "test:mvp": "npm run events:validate:self-test && npm run audit:links:self-test && npm run validate:artist-providers && npm run validate:cta-provider-state && node scripts/smoke-prelaunch.mjs",
    "validate:artist-providers": "node scripts/validate-artist-provider-claims.mjs",
    "validate:cta-provider-state": "node scripts/validate-cta-provider-state.mjs",
    "validate:cta-provider-state:self-test": "node scripts/validate-cta-provider-state.mjs --self-test",
    "test:prelaunch": "npm run test:mvp",
    "demand:migrate": "wrangler d1 execute tourticketcompare-demand --remote --file migrations/0001_demand.sql",
    "demand:export": "wrangler d1 execute tourticketcompare-demand --remote --command \"SELECT * FROM email_subscribers\"",
    "events:partition": "python3 scripts/partition-events.py",
    "events:sync": "python3 scripts/sync-events-data.py",
    "events:validate": "python3 scripts/validate-events.py",
    "events:validate:prod": "python3 scripts/validate-events.py --for-production",
    "events:validate:self-test": "python3 scripts/validate-events.py --self-test",
    "events:validate:partitions": "node scripts/validate-partitions.mjs",
    "events:update": "python3 scripts/validate-events.py && python3 scripts/partition-events.py && python3 scripts/sync-events-data.py",
    "artist:check": "node scripts/validate-artist.mjs",
    "artist:promote": "node scripts/promote-artist.mjs",
    "artists:onboard:propose": "node scripts/propose-onboarding-batch.mjs",
    "artists:onboard:propose:self-test": "node scripts/propose-onboarding-batch.mjs --self-test",
    "artists:promote:batch": "node scripts/promote-artists-batch.mjs",
    "artists:promote:batch:self-test": "node scripts/promote-artists-batch.mjs --self-test",
    "artists:propose": "node scripts/propose-artists.mjs",
    "artists:diagnose-ticketmaster": "node scripts/propose-artists.mjs --diagnose-ticketmaster",
    "artists:apply-preview": "node scripts/apply-artists.mjs",
    "guides:validate": "node scripts/validate-guide-routes.mjs",
    "schema:validate": "node scripts/validate-route-schema.mjs",
    "providers:validate": "node scripts/validate-provider-structure.js",
    "validate:provider-allowlists": "node scripts/validate-provider-allowlists.mjs",
    "providers:identities:validate": "node scripts/validate-provider-identities.mjs",
    "providers:sync:tm:dry-run": "python3 scripts/sync-ticketmaster-events.py --all-approved --dry-run",
    "providers:sync:tm:self-test": "python3 scripts/sync-ticketmaster-events.py --self-test",
    "providers:sync:tm:write-pr": "node scripts/sync-tm-events-write-pr.mjs",
    "providers:sync:tm:write-pr:self-test": "node scripts/sync-tm-events-write-pr.mjs --self-test",
    "providers:parity": "node scripts/report-provider-parity.mjs",
    "test:providers": "npm run providers:validate",
    "data:stats": "node scripts/report-data-stats.mjs",
    "audit:links": "node scripts/verify-outbound-links.mjs",
    "audit:links:self-test": "node scripts/verify-outbound-links.mjs --self-test",
    "audit:tm-events": "node scripts/audit-tm-events.mjs",
    "audit:report": "node scripts/daily-audit-report.mjs",
    "audit:bump-dates": "node scripts/bump-verified-dates.mjs",
    "audit:backfill-discovery-ids": "node scripts/backfill-discovery-ids.mjs",
    "providers:sync:tm:coverage": "node scripts/report-tm-discovery-coverage.mjs",
    "providers:sync:tm:coverage:self-test": "node scripts/report-tm-discovery-coverage.mjs --self-test",
    "test:bump-guard": "node scripts/test-bump-verified-dates-guard.mjs",
    "data:sync-tm": "node scripts/apply-tm-updates.mjs",
    "data:sync-tm:dry-run": "node scripts/apply-tm-updates.mjs --dry-run",
    "data:sync-review": "node scripts/report-tm-sync-review.mjs",
    "seatgeek:self-test": "node scripts/propose-seatgeek-urls.mjs --self-test",
    "seatgeek:propose": "node scripts/propose-seatgeek-urls.mjs",
    "seatgeek:enrich": "node scripts/enrich-seatgeek-events.mjs",
    "seatgeek:enrich:apply": "node scripts/enrich-seatgeek-events.mjs --apply-high-confidence",
    "seatgeek:verify": "node scripts/verify-seatgeek-events.mjs",
    "seatgeek:verify:apply": "node scripts/verify-seatgeek-events.mjs --apply",
    "seatgeek:verify:self-test": "node scripts/verify-seatgeek-events.mjs --self-test",
    "seatgeek:prices:self-test": "node scripts/snapshot-seatgeek-prices.mjs --self-test",
    "seatgeek:prices:dry-run": "node scripts/snapshot-seatgeek-prices.mjs",
    "seatgeek:prices:apply": "node scripts/snapshot-seatgeek-prices.mjs --apply",
    "vividseats:sync": "node scripts/sync-vividseats-events.mjs",
    "vividseats:sync:apply": "node scripts/sync-vividseats-events.mjs --apply",
    "vividseats:sync:self-test": "node scripts/sync-vividseats-events.mjs --self-test",
    "events:check-fallback-freshness": "node scripts/check-fallback-freshness.mjs",
    "audit:production-routes": "node scripts/verify-production-route-html.mjs",
    "vividseats:prices:self-test": "node scripts/snapshot-vividseats-prices.mjs --self-test",
    "vividseats:prices:dry-run": "node scripts/snapshot-vividseats-prices.mjs",
    "vividseats:prices:apply": "node scripts/snapshot-vividseats-prices.mjs --apply"
  },
  "devDependencies": {
    "wrangler": "^4.106.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "8.21.0"
  }
}
