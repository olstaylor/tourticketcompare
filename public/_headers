/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self'; script-src 'self' 'sha256-Q30wDQV17e4Sw7Z8x8BcoikGk7p+X/bWhMr3O6oTA40=' 'sha256-kgQCJ07+PwbzPANIIBLqfYKC2xWyEIALdj/MfbxDUTc=' https://*.googletagmanager.com https://utt.impactcdn.com; connect-src 'self' https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://stats.g.doubleclick.net https://www.google.com https://utt.impactcdn.com; frame-src https://www.googletagmanager.com; base-uri 'self'; frame-ancestors 'none'; object-src 'none'

# Versioned static assets: every reference carries a ?v= cache-busting query
# string that is bumped whenever the file changes, so they are safe to cache
# for a year. Bump the ?v= at every reference when editing one of these files.
/app.js
  Cache-Control: public, max-age=31536000, immutable

/web-vitals.js
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/ttc-home.css
  Cache-Control: public, max-age=31536000, immutable

/ttc-home.js
  Cache-Control: public, max-age=31536000, immutable

/ttc-shell.css
  Cache-Control: public, max-age=31536000, immutable

/shell.js
  Cache-Control: public, max-age=31536000, immutable

/artist-board.js
  Cache-Control: public, max-age=31536000, immutable

/currency-converter.js
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/data/fallback-catalog.json
  Cache-Control: public, max-age=604800

/data/events.json
  Cache-Control: public, max-age=600

/data/events-index.json
  Cache-Control: public, max-age=600

/data/events/*
  Cache-Control: public, max-age=600

/data/artists.json
  Cache-Control: public, max-age=3600

/data/catalog.json
  Cache-Control: public, max-age=1800

/data/*
  X-Robots-Tag: noindex, nofollow

/internal/*
  X-Robots-Tag: noindex, nofollow

# The content editor's own assets. The /admin document itself is served by
# functions/admin.js, which sets the editor's Content-Security-Policy directly;
# these are the vendored editor bundle and its configuration.
/admin/*
  X-Robots-Tag: noindex, nofollow

/admin/sveltia-cms.js
  Cache-Control: public, max-age=3600

/og-image.png
  Cache-Control: public, max-age=604800

# The square brand mark referenced as the Organization's logo in JSON-LD.
# Rasterised from public/assets/logo.svg; see that file's header comment.
/logo.png
  Cache-Control: public, max-age=604800

# Generated per-page social cards. Excluded from Functions in _routes.json, so
# these are served straight from the asset layer — the /* security headers above
# still apply, since those are applied by Pages rather than the middleware.
/og/*
  Cache-Control: public, max-age=604800
